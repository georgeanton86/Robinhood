# Copy this file to .env and fill in your values. .env is gitignored.

# --- Safety mode -----------------------------------------------------------
# One of: backtest | paper | live
# Live is IGNORED unless ALLOW_LIVE_TRADING below is set to the exact phrase.
TRADING_MODE=paper

# Real-money trading is refused unless this is EXACTLY:
#   YES_I_UNDERSTAND_THE_RISKS
# Leave blank to stay safe.
ALLOW_LIVE_TRADING=

# --- Broker: Alpaca --------------------------------------------------------
# Get FREE paper-trading keys at https://alpaca.markets (Paper Trading section).
# These are PAPER keys — fake money. Do not paste live keys unless you have
# deliberately decided to go live (see README).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Paper endpoint by default. Only change if you truly mean to trade live.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Universe & schedule ---------------------------------------------------
SYMBOLS=SPY,QQQ
# Morning-only window (matches the common design). Times are in this tz.
MARKET_TIMEZONE=America/Chicago
TRADE_WINDOW_START=09:00
TRADE_WINDOW_END=11:00
# Seconds between decision cycles in the live/paper loop.
LOOP_INTERVAL_SECONDS=60

# --- Risk controls ---------------------------------------------------------
STARTING_CASH=30000          # used by sim/backtest only
MAX_POSITION_PCT=0.20        # max % of equity in a single position
MAX_TOTAL_EXPOSURE_PCT=1.0   # max % of equity deployed across all positions
MAX_DAILY_LOSS_PCT=0.03      # halt trading for the day after this drawdown
STOP_LOSS_PCT=0.02           # per-position stop loss
TAKE_PROFIT_PCT=0.04         # per-position take profit
MAX_OPEN_POSITIONS=4

# --- Strategy params -------------------------------------------------------
MOMENTUM_LOOKBACK=10         # bars used to measure momentum
MOMENTUM_THRESHOLD=0.001     # min return to trigger a signal (0.1%)

# --- Optional: news sentiment feed ----------------------------------------
# Leave blank to use the offline neutral stub. Plug in a real provider for live.
NEWS_API_KEY=
